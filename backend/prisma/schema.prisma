generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  phone     String?
  role      UserRole
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonSchedules LessonSchedule[] @relation("TutorLessonSchedules")
  lessons         Lesson[]         @relation("TutorLessons")
}

enum UserRole {
  ADMIN
  TUTOR
}

model School {
  id    Int     @id @default(autoincrement())
  name  String
  email String?
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pupils Pupil[]
}

model Pupil {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  schoolId  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  lessonSchedules LessonSchedule[] @relation("PupilLessonSchedules")
  lessons         Lesson[]         @relation("PupilLessons")
}

model LessonSchedule {
  id Int @id @default(autoincrement())

  tutorId Int
  pupilId Int

  subject String

  dayOfWeek DayOfWeek
  startTime String
  duration Int

  venue String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor User @relation("TutorLessonSchedules", fields: [tutorId], references: [id])
  pupil Pupil @relation("PupilLessonSchedules", fields: [pupilId], references: [id])

  lessons Lesson[]
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Lesson {
  id Int @id @default(autoincrement())

  scheduleId Int?

  pupilId Int
  tutorId Int

  startTime DateTime
  duration  Int
  subject   String
  venue     String?

  pupil Pupil @relation("PupilLessons", fields: [pupilId], references: [id])
  tutor User  @relation("TutorLessons", fields: [tutorId], references: [id])

  schedule LessonSchedule? @relation(fields: [scheduleId], references: [id])

  report Report?
}

model Report {
  id       Int @id @default(autoincrement())
  lessonId Int @unique

  engagementScore       Int
  attentionScore        Int
  confidenceScore       Int
  academicProgressScore Int

  emotionalRegulation            EmotionalRegulation?
  emotionalRegulationExplanation String?

  lessonObjective String?

  pupilActivity String?

  lessonOutcome String?

  strategyImpact String?

  nextSessionTarget String?
  tutorReflection   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id])

  reportStrategies ReportStrategy[]
  reportEvidence   ReportEvidence[]
}

enum EmotionalRegulation {
  CALM
  HAPPY
  ANXIOUS
  WITHDRAWN
  TIRED
  DYSREGULATED
  UNCONTROLLED
  OTHER
}

model Strategy {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportStrategies ReportStrategy[]
}

model ReportStrategy {
  reportId   Int
  strategyId Int

  report   Report   @relation(fields: [reportId], references: [id])
  strategy Strategy @relation(fields: [strategyId], references: [id])

  @@id([reportId, strategyId])
}

model EvidenceType {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reportEvidence ReportEvidence[]
}

model ReportEvidence {
  reportId       Int
  evidenceTypeId Int

  report       Report       @relation(fields: [reportId], references: [id])
  evidenceType EvidenceType @relation(fields: [evidenceTypeId], references: [id])

  @@id([reportId, evidenceTypeId])
}
